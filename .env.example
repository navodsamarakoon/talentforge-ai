# Copy these placeholders into your local .env and replace them before starting.
POSTGRES_USER=talentforge
POSTGRES_PASSWORD=replace-with-64-hex-characters
POSTGRES_DB=talentforge
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://talentforge:replace-with-64-hex-characters@localhost:5432/talentforge
JWT_EXPIRY_MINUTES=60
INVITATION_EXPIRY_HOURS=72
CV_UPLOAD_DIR=/var/lib/talentforge/cvs
CV_AUTOMATION_ENABLED=false
CV_OLLAMA_URL=http://host.docker.internal:11434
CV_OLLAMA_MODEL=llama3.2:3b
CV_OLLAMA_TIMEOUT_SECONDS=120
N8N_AUTO_DISPATCH_ENABLED=false
N8N_WEBHOOK_URL=http://n8n:5678/webhook/talentforge-cv-screening
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
VACANCY_EMAIL_DELIVERY_ENABLED=false
VACANCY_EMAIL_DAILY_CAP=25
CANDIDATE_DASHBOARD_BASE_URL=
SANDBOX_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_CODE_CHARS=20000
AI_ENABLED=false
AI_TIMEOUT_SECONDS=270
INSTALL_RETRIEVAL_DEPS=false
RETRIEVAL_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=240
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Optional external Neo4j settings (do not put production credentials here).
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Numeric group ID of /var/run/docker.sock; used only by sandbox-runner.
DOCKER_GID=
